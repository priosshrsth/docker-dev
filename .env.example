# Copy to .env and adjust.

# Which optional services to start with a plain `docker compose up -d`.
# Postgres always runs. Available: proxy, mysql, mysql5, redis, dragonfly, gcs, mail
#   Linux: include `proxy` (Caddy serves https://*.localhost)
#   macOS: leave `proxy` out (OrbStack serves *.orb.local)
COMPOSE_PROFILES=proxy,redis,mail

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=app
# POSTGRES_PORT=5432

# MySQL
# MYSQL_ROOT_PASSWORD=root
# MYSQL_DATABASE=app
# MYSQL_USER=app
# MYSQL_PASSWORD=app
# MYSQL_PORT=3306
# MYSQL5_PORT=3305

# Redis / Dragonfly
# REDIS_PORT=6379
# REDIS_APPENDONLY=yes
# DRAGONFLY_PORT=6380

# GCS emulator
# GCS_PORT=4443
# GCS_PUBLIC_HOST=gcs.localhost:4443   # macOS alternative: gcs.orb.local:4443

# Mailpit
# SMTP_PORT=1025
# SMTP_WEB_PORT=8326
